# Download/media data directories — keep structure, ignore contents
data/downloads/**
!data/downloads/.gitkeep
!data/downloads/*/
!data/downloads/*/.gitkeep
data/torrents/**
!data/torrents/.gitkeep
!data/torrents/*/
!data/torrents/*/.gitkeep
data/usenet/**
!data/usenet/.gitkeep
!data/usenet/*/
!data/usenet/*/.gitkeep
!data/usenet/complete/*/
!data/usenet/complete/*/.gitkeep
data/media/**
!data/media/*/
!data/media/*/.gitkeep
# Cover art is one level deeper (data/media/covers/<app>), so it needs its own
# negations, same as data/usenet/complete/*/ above. Structure only: the images
# themselves stay ignored.
!data/media/covers/*/
!data/media/covers/*/.gitkeep
data/recycle/**
!data/recycle/*/
!data/recycle/*/.gitkeep
# Scheduled *arr database backups (data/backups/<app>). These contain real
# library data and can run to hundreds of MiB, so only the structure is kept.
data/backups/**
!data/backups/.gitkeep
!data/backups/*/
!data/backups/*/.gitkeep

# Observability storage — keep structure, ignore runtime data
storage/alloy/data/*
storage/prometheus/data/*
storage/loki/data/*
storage/grafana/data/*
!storage/alloy/data/.gitkeep
!storage/prometheus/data/.gitkeep
!storage/loki/data/.gitkeep
!storage/grafana/data/.gitkeep

