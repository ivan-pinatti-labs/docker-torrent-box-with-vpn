# Overrides applied on top of .env by `make bootstrap_tests`
# (scripts/enable-test-profiles.sh), for a full test-coverage run. Mostly
# profiles, plus a Jellyfin test domain and, at the end, the three network
# subnets.
#
# Only lines that need to change from .env.example's defaults belong here.
# Each profile below has real pytest coverage that never runs otherwise;
# see README.md's "Full test coverage" section for the reasoning and for
# which disabled profiles are deliberately NOT here (no-op stubs or
# services with zero test coverage either way).
#
# No secrets live in this file. It's tracked directly, unlike the
# .env.example / .env split docs/COMPOSE_CONVENTIONS.md documents for
# services that do carry real credentials.

WHISPARR_PROFILE=enabled
NZBHYDRA2_PROFILE=enabled

# NZBGET_PROFILE deliberately stays disabled, unlike its neighbors above.
# configs/nginx/templates/default.conf.template's /nzbget/ location block
# is itself commented out ("Legacy NZBGet endpoint retained for existing
# setups only"), the same "legacy, not actively maintained" framing
# .env.example already gives Jackett, so test_nzbget_api_auth's nginx-proxied
# request can never succeed here regardless of this profile's state,
# confirmed live. Enabling it would just trade one guaranteed-red test for
# another, not add real coverage.

CADVISOR_PROFILE=enabled
GRAFANA_PROFILE=enabled
LOKI_PROFILE=enabled
NODE_EXPORTER_PROFILE=enabled
PROMETHEUS_PROFILE=enabled
ALLOY_PROFILE=enabled
NGINX_EXPORTER_PROFILE=enabled
PODMAN_EXPORTER_PROFILE=enabled
PODMAN_LIMITS_EXPORTER_PROFILE=enabled
QBITTORRENT_EXPORTER_PROFILE=enabled
SABNZBD_EXPORTER_PROFILE=enabled

# Local, credential-free WireGuard endpoint so qBittorrent/SABnzbd (both
# depends_on: gluetun: condition: service_healthy) and everything wired
# through them can actually start without a real VPN provider account.
# scripts/enable-test-profiles.sh only acts on this if
# configs/gluetun/.secret is still empty/placeholder; a real key already in
# place is never overwritten. See docs/VPN_MOCK.md.
VPN_MOCK_PROFILE=enabled

# A name for Jellyfin's optional nginx virtual host, so
# test_jellyfin_proxy_domain_reachable has one to reach instead of skipping on
# .env.example's `jellyfin.invalid` placeholder. The test sends it as a Host
# header to nginx's own address, so nothing has to resolve it; `.test` is
# reserved for exactly this (RFC 2606). The certificate step reads it too, so
# the test certificate names it.
JELLYFIN_PROXY_DOMAIN=jellyfin.test

# Networks, moved off .env.example's 172.28/29/30 so a test run never collides
# with a deployment on the same host. `make start`'s "ensure required networks
# exist" step reads the three subnets to create
# ${COMPOSE_PROJECT_NAME}_services, _observability and _media, and a podman
# network persists while its stack is stopped, so a checkout that inherits
# .env.example's values cannot create its own: `make start` dies on
# "Error: subnet 172.28.0.0/24 is already used on the host or by another
# config", which names neither the variable to change nor the checkout holding
# it. Hit for real bringing a second checkout up beside a stopped deployment.
#
# #92 made a second checkout safe by giving the networks per-project *names*;
# the subnets behind those names stayed shared, which is the other half of the
# same problem.
#
# The four static addresses have to move with the subnets, and this is the whole
# reason moving them is not a one line change. Each is assigned by an
# `ipv4_address:` in a compose file, so leaving one behind puts a container
# outside its own network, and wire-connections.sh writes GLUETUN_SERVICES_IP
# into every arr's download client, so a stale value turns into "Unable to
# communicate with QBittorrent. Connection refused (172.28.0.10:8085)" in an
# arr's health endpoint. That surfaces as a pytest *warning* rather than a
# failure, so a run can go green with the download clients unreachable. Found
# exactly that way.
#
# The offsets inside each subnet are kept identical to .env.example's, and both
# static addresses stay below their subnet's dynamic range
# (SERVICES_DYNAMIC_IP_RANGE starts at .128, MEDIA_DYNAMIC_IP_RANGE at .16).
SERVICES_SUBNET=172.25.0.0/24
SERVICES_DYNAMIC_IP_RANGE=172.25.0.128/25
GLUETUN_SERVICES_IP=172.25.0.10
VPN_MOCK_IP=172.25.0.11
OBSERVABILITY_SUBNET=172.26.0.0/24
GLUETUN_OBSERVABILITY_IP=172.26.0.10
MEDIA_SUBNET=172.27.0.0/24
MEDIA_DYNAMIC_IP_RANGE=172.27.0.16/28
NGINX_MEDIA_IP=172.27.0.10
