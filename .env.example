# Container Runtime
# Set to 'podman' (recommended) or 'docker'.
# If unset, the Makefile auto-detects: Podman is used when available, Docker otherwise.
# Tip: install 'podman-docker' to keep using the 'docker' command while running Podman underneath.
CONTAINER_RUNTIME=podman

# Python version CI provisions via actions/setup-python in
# .github/workflows/pull-request-validation.yml. One place to bump instead
# of three. Not used locally: tests/.venv uses whatever python3 is already
# on your PATH (see Requisites in README.md), deliberately looser than CI's
# exact pin.
PYTHON_VERSION=3.14

### SYSTEM
UID=1000
GID=1000
TIMEZONE=America/Toronto
UMASK=022
LAN_IP=192.168.1.x
DOMAIN=localhost

# Service process identities
QBITTORRENT_UID=1101
QBITTORRENT_GID=1101
SABNZBD_UID=1102
SABNZBD_GID=1102
JDOWNLOADER2_UID=1103
JDOWNLOADER2_GID=1103
NZBHYDRA2_UID=1104
NZBHYDRA2_GID=1104
SONARR_UID=1201
SONARR_GID=1201
RADARR_UID=1202
RADARR_GID=1202
LIDARR_UID=1203
LIDARR_GID=1203
READARR_UID=1204
READARR_GID=1204
WHISPARR_UID=1205
WHISPARR_GID=1205
BAZARR_UID=1206
BAZARR_GID=1206
LAZYLIBRARIAN_UID=1207
LAZYLIBRARIAN_GID=1207
MYLAR_UID=1208
MYLAR_GID=1208
PROWLARR_UID=1210
PROWLARR_GID=1210
RECYCLARR_UID=1211
RECYCLARR_GID=1211
FLARESOLVERR_UID=1212
FLARESOLVERR_GID=1212
JELLYFIN_UID=1301
JELLYFIN_GID=1301
AUDIOBOOKSHELF_UID=1302
AUDIOBOOKSHELF_GID=1302
CALIBRE_UID=1303
CALIBRE_GID=1303
CALIBREWEB_UID=1304
CALIBREWEB_GID=1304
KORSYNC_UID=1305
KORSYNC_GID=1305
HOMEPAGE_UID=1401
HOMEPAGE_GID=1401
NGINX_UID=101
NGINX_GID=101
LOG_ROTATOR_UID=1504
LOG_ROTATOR_GID=1504
PROMETHEUS_UID=65534
PROMETHEUS_GID=65534
LOKI_UID=10001
LOKI_GID=10001
GRAFANA_UID=472
GRAFANA_GID=472
ALLOY_UID=473
ALLOY_GID=473

### NETWORKS
SERVICES_SUBNET=172.28.0.0/24
OBSERVABILITY_SUBNET=172.29.0.0/24
MEDIA_SUBNET=172.30.0.0/24
GLUETUN_SERVICES_IP=172.28.0.10
GLUETUN_OBSERVABILITY_IP=172.29.0.10
NGINX_MEDIA_IP=172.30.0.10
# Only reachable when VPN_MOCK_PROFILE is enabled; see docs/VPN_MOCK.md.
VPN_MOCK_IP=172.28.0.11
# Dynamic-allocation pool for services, excluding GLUETUN_SERVICES_IP and
# VPN_MOCK_IP's range so a container without a static address can't be
# handed one of those two reserved addresses before its owner claims it.
# Confirmed live twice: recyclarr (no static IP of its own) was dynamically
# handed VPN_MOCK_IP first at 172.28.0.99, then again at 172.28.0.11 after
# moving it there in response to the first collision (as bazarr, the second
# time) — a low address is not inherently safer without an explicit
# exclusion range; only the exclusion itself is. Either time, this starved
# vpn_mock of its own reserved address and left gluetun trying to dial a
# WireGuard endpoint that was never actually listening. Sized as a /25
# (126 usable addresses), not a /28 like MEDIA_DYNAMIC_IP_RANGE: most of
# this stack's containers sit on the services network, and a /28 (14
# usable) ran out mid-bootstrap on the very first try ("failed to find
# free IP in range").
SERVICES_DYNAMIC_IP_RANGE=172.28.0.128/25
# Dynamic-allocation pool for media, excluding NGINX_MEDIA_IP's range so a
# container without a static address (jellyfin, audiobookshelf, calibre,
# calibre-web) can't be handed nginx's reserved IP before nginx claims it.
MEDIA_DYNAMIC_IP_RANGE=172.30.0.16/28

### VPN
VPN_PROVIDER=gluetun
# Optional comma- or space-separated services to route through gluetun.
# Examples: VPN_ON=sonarr,radarr or VPN_ON=servarr
VPN_ON=
# Gluetun provider, protocol, server selection, and port forwarding live in configs/gluetun/.env.
# For WireGuard providers, paste the private key (single line) into configs/gluetun/.secret.

### FOLDERS
# Certificate subject fields (CERT_COUNTRY, CERT_FQDN, CERT_PASSWORD, etc.) are
# not here: they live in certs/cert.conf, seeded from certs/cert.conf.example
# on the first `make` invocation. Interpolated compose values like DOMAIN stay
# in this file; per-service secrets stay out of it. See docs/COMPOSE_CONVENTIONS.md.
CERTIFICATES_FOLDER=./certs
CACHE_FOLDER=./cache
CONFIG_FOLDER=./configs
LOGS_FOLDER=./logs
STORAGE_FOLDER=./storage
# Every path below derives from DATA_FOLDER on purpose: it is the single knob
# that relocates the whole tree onto external storage. See docs/STORAGE.md.
DATA_FOLDER=./data
TORRENTS_FOLDER="${DATA_FOLDER}/torrents"
USENET_FOLDER="${DATA_FOLDER}/usenet"
DOWNLOADS_FOLDER="${DATA_FOLDER}/downloads"
TORRENT_BLACKHOLE_FOLDER="${DATA_FOLDER}/torrents/blackhole"
USENET_BLACKHOLE_FOLDER="${DATA_FOLDER}/usenet/blackhole"
# Cover art the *arr apps cache under their own config directory, with no
# setting to relocate it, so each app gets a bind mount over /config/MediaCover
# instead. Moved onto DATA_FOLDER because it is media, not configuration: it can
# reach several GiB across thousands of small files. Keeping it here takes it off
# the host's local disk, out of backup-full, and lets it follow the library onto
# external storage. Regenerable: the apps refetch on a metadata refresh.
MEDIA_COVERS_FOLDER="${DATA_FOLDER}/media/covers"
# Scheduled database backups the *arr apps write under their own config
# directory. Relocated for durability rather than size: on external storage
# they survive losing the host, whereas inside configs/ they die with it.
APP_BACKUPS_FOLDER="${DATA_FOLDER}/backups"
# Volume suffix used by the data mounts in the compose files. ":z" when
# DATA_FOLDER is a local directory that Podman may relabel, empty when it is a
# CIFS mount: cifs has no security.selinux xattr, so a :z relabel fails there
# and the label has to come from STORAGE_SELINUX_CONTEXT at mount time.
DATA_VOLUME_FLAGS=:z

### EXTERNAL STORAGE
# Leave STORAGE_REMOTE empty to keep DATA_FOLDER on local disk. When set,
# scripts/storage-mount.sh manages a single CIFS mount at STORAGE_MOUNTPOINT.
# One share, one mount, deliberately: data/torrents and data/media must sit on
# the same filesystem or every *arr import silently degrades from a hardlink to
# a full copy, roughly doubling the space an imported library occupies.
# SMB credentials live in configs/storage/.smbcredentials, seeded from
# .smbcredentials.example. No secrets belong in this file.
STORAGE_REMOTE=
STORAGE_MOUNTPOINT="${DATA_FOLDER}"
STORAGE_CREDENTIALS_FILE="${CONFIG_FOLDER}/storage/.smbcredentials"
STORAGE_CIFS_VERSION=3.1.1
STORAGE_CIFS_UID=1000
STORAGE_CIFS_GID=1000
STORAGE_CIFS_FILE_MODE=0664
STORAGE_CIFS_DIR_MODE=0775
# noperm is load bearing: under rootless Podman the host user maps to uid 0
# inside the container namespace, so a service running as uid 1101 falls
# through to "other" permissions and gets read-only access to its own
# downloads. noperm skips the client-side check and makes the SMB credentials
# the access boundary. serverino keeps the server's real inode numbers, which
# is what lets rsync -H and the *arr apps see existing hardlinks at all.
# nobrl is deliberately absent: it disables byte-range locking, and Calibre and
# Calibre-Web both write data/media/calibre-library/metadata.db, so SQLite
# needs the server to arbitrate those locks.
STORAGE_CIFS_EXTRA_OPTIONS=noperm,mfsymlinks,serverino,cache=strict,actimeo=120
# SELinux label applied at mount time, replacing the per-volume :z relabel.
STORAGE_SELINUX_CONTEXT=system_u:object_r:container_file_t:s0

### CREDENTIAL ROTATION
# Length and character set for passwords generated by rotate-passwords.sh
# and rotate-all.sh. ROTATE_PASSWORD_SPECIAL_CHARS=true adds a safe symbol
# subset (! @ ^ * ( ) _ ~ -); see the comment above gen_password() in
# scripts/rotate-passwords.sh for why those specific symbols were chosen.
ROTATE_PASSWORD_LENGTH=16
ROTATE_PASSWORD_SPECIAL_CHARS=false

### GROWTH CONTROLS
# These controls avoid runaway growth without applying host filesystem quotas
# or automatically deleting torrent/usenet payloads.
DISK_WARN_PERCENT=80
DISK_CRIT_PERCENT=90
DOWNLOADS_WARN_GB=500
DOWNLOADS_CRIT_GB=750
LOG_ROTATOR_PROFILE=enabled
LOG_ROTATION_CRON=30 3 * * *
LOG_RETENTION_DAYS=30
LOG_ARCHIVE_RETENTION_DAYS=90
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=10GB
LOKI_RETENTION_PERIOD=90d
NGINX_PROXY_CACHE_MAX_SIZE=1g
NGINX_PROXY_CACHE_INACTIVE=7d

### CONTAINER LIMITS
# CPU values are quotas, not reservations. Memory is the RAM ceiling.
NGINX_CPUS=0.5
NGINX_MEMORY=512mb
SERVARR_CPUS=0.5
SERVARR_MEMORY=512mb
SERVARR_PIDS=300
FLARESOLVERR_CPUS=1
FLARESOLVERR_MEMORY=1gb
DOWNLOADERS_CPUS=2
DOWNLOADERS_MEMORY=1gb
NZBHYDRA2_CPUS=1
NZBHYDRA2_MEMORY=1gb
GLUETUN_CPUS=1
GLUETUN_MEMORY=1gb
# Increase to 2 if Jellyfin will do CPU transcoding.
JELLYFIN_CPUS=1
JELLYFIN_MEMORY=1gb
GRAFANA_CPUS=1
GRAFANA_MEMORY=1.5gb
TELEMETRY_CPUS=0.25
TELEMETRY_MEMORY=256mb
# Alloy overrides the shared telemetry memory limit above: it's a heavier
# collector than the other services sharing that default.
ALLOY_MEMORY=512mb
HOMEPAGE_CPUS=0.25
HOMEPAGE_MEMORY=256mb
LOG_ROTATOR_CPUS=0.25
LOG_ROTATOR_MEMORY=64mb
CALIBRE_CPUS=0.5
CALIBRE_MEMORY=1gb
CALIBREWEB_CPUS=0.5
CALIBREWEB_MEMORY=512mb
AUDIOBOOKSHELF_CPUS=0.5
AUDIOBOOKSHELF_MEMORY=512mb
KORSYNC_CPUS=0.25
KORSYNC_MEMORY=128mb

### JELLYFIN ACCESS
# Default: Jellyfin is canonical at /jellyfin through nginx.
# Set JELLYFIN_BASE_URL= to make direct/domain-root access canonical instead.
JELLYFIN_BASE_URL=/jellyfin
JELLYFIN_PROXY_DOMAIN=jellyfin.invalid
JELLYFIN_KNOWN_PROXY=${NGINX_MEDIA_IP}

### PROFILES
# Core (enabled by default)
BAZARR_PROFILE=enabled
FLARESOLVERR_PROFILE=enabled
HOMEPAGE_PROFILE=enabled
JELLYFIN_PROFILE=enabled
LIDARR_PROFILE=enabled
NGINX_PROFILE=enabled
GLUETUN_PROFILE=enabled
JDOWNLOADER2_PROFILE=enabled
PROWLARR_PROFILE=enabled
QBITTORRENT_PROFILE=enabled
RADARR_PROFILE=enabled
READARR_PROFILE=enabled
SABNZBD_PROFILE=enabled
SONARR_PROFILE=enabled
AUDIOBOOKSHELF_PROFILE=enabled
CALIBRE_PROFILE=enabled
CALIBREWEB_PROFILE=enabled
KORSYNC_PROFILE=enabled
LAZYLIBRARIAN_PROFILE=enabled
MYLAR_PROFILE=enabled
RECYCLARR_PROFILE=enabled

# Optional (disabled by default)
NOTIFIARR_PROFILE=disabled
NZBHYDRA2_PROFILE=disabled
PLEX_PROFILE=disabled
# Local credential-free WireGuard endpoint used by `make bootstrap_tests`;
# never enable this for a real deployment. See docs/VPN_MOCK.md.
VPN_MOCK_PROFILE=disabled
WHISPARR_PROFILE=disabled

# Monitoring (disabled by default)
CADVISOR_PROFILE=disabled
GRAFANA_PROFILE=disabled
LOKI_PROFILE=disabled
NODE_EXPORTER_PROFILE=disabled
PROMETHEUS_PROFILE=disabled
ALLOY_PROFILE=disabled
NGINX_EXPORTER_PROFILE=disabled
PODMAN_EXPORTER_PROFILE=disabled
PODMAN_LIMITS_EXPORTER_PROFILE=disabled
QBITTORRENT_EXPORTER_PROFILE=disabled
SABNZBD_EXPORTER_PROFILE=disabled

# Legacy apps (disabled by default; retained for existing setups only)
# Jackett has no compose service of its own any more, so nothing pulls its pin
# and no runtime pytest layer exercises it; tests/test_renovate_pins.py covers
# the pin itself, and carries the exemption saying why there is no image
# reference to check the annotation against. The pin is still watched, because a
# frozen image is a worse starting point than a current one for whoever turns
# the service back on.
JACKETT_PROFILE=disabled
NZBGET_PROFILE=disabled

### CONTAINER NAMES
# Prefix prepended to every container_name, and to the container reference in
# the download clients' network_mode. Empty by default, so a deployment's
# containers are named exactly as they always have been and nothing that talks
# to them by name has to change.
#
# It exists so a second checkout can run beside a deployment. Podman container
# names are global while pods and networks are per project, so two checkouts
# with the same names collide on the names alone: whichever one owns them holds
# them, and the other's `make start` fails to create a single container while
# still exiting zero. Confirmed by running both at once, where the second
# checkout produced 33 "the container name is already in use" errors and ended
# with an empty pod.
#
# Set this in the second checkout's own .env, not here, and give it a trailing
# separator: CONTAINER_PREFIX=dev- yields dev-gluetun, dev-sonarr and so on.
# Service names are untouched, which is what keeps this cheap: podman-compose
# takes each container's network alias from the service name, so inter-container
# DNS, nginx's upstreams, Prometheus's scrape targets and Homepage's widget URLs
# all keep resolving whatever this is set to.
CONTAINER_PREFIX=

