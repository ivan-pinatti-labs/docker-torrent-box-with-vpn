# linuxserver.io images run their s6-overlay init as root and drop to the
# PUID/PGID identity themselves, so a USER instruction here would break startup
# before the app ever runs. Health is defined per service in the compose files,
# where it can probe the real HTTP endpoint and port rather than guess.
# Trivy reports the same two findings as DS-0002 and DS-0026; its inline
# ignores do not apply to whole-file checks, so those live in .trivyignore.yaml.
#checkov:skip=CKV_DOCKER_3:s6-overlay must init as root; the app runs as PUID/PGID
#checkov:skip=CKV_DOCKER_2:healthcheck is defined on the service in docker-compose-servarr.yml

# No default: compose always passes BASE_VERSION from ${LAZYLIBRARIAN_VERSION},
# and a bare `docker build` should fail loudly rather than quietly produce an
# image built on :latest that no longer matches the pinned version.
ARG BASE_VERSION
# Digest pinned. This line carried a bare tag until 2026-09-03, which meant
# the Calibre that ends up inside the wrapper was whatever the mod happened to
# be at build time, with nothing in any diff recording which one. Renovate's
# dockerfile manager already reads this file and pinDigests is on globally, so
# the only reason it was never maintained is that there was no digest here to
# maintain.
#
# Most of what this stack pulls is digest pinned, not all of it: three tags
# float deliberately, with a reason recorded for each in the FLOATING
# allowlist in tests/test_renovate_pins.py and under "Remaining gaps" in
# docs/DEPENDENCY_UPDATES.md.
#
# tests/test_version_pins.py's test_lazylibrarian_carries_the_calibre_mod
# checks that this layer survived the build, by reading the CALIBRE_RELEASE
# file the mod ships and the COPY below brings in, and by running calibredb.
# It deliberately asserts no version: the digest above already fixes which
# Calibre this is, and hardcoding it in the test as well would fail on every
# digest bump and take the automerge path down with it.
# renovate: datasource=docker depName=docker.io/linuxserver/mods versioning=docker
FROM docker.io/linuxserver/mods:universal-calibre@sha256:ceae75f021e73a049fcea41777dc8b1f2adeb5da10d2749caca12ca290293cce AS calibre-mod

FROM docker.io/linuxserver/lazylibrarian:${BASE_VERSION}
COPY --from=calibre-mod /calibre.txz /calibre.txz
COPY --from=calibre-mod /CALIBRE_RELEASE /CALIBRE_RELEASE
COPY --from=calibre-mod /etc/s6-overlay/s6-rc.d/init-mod-universal-calibre-add-package/run /tmp/calibre-deps.sh
# DL3008 asks for pinned apt versions. The package list is not written here: it
# is generated by the calibre mod's own init script into
# /mod-repo-packages-to-install.list, so there is nothing to pin against and the
# set changes with the upstream mod rather than with this file.
#
# SC2046 wants the command substitution quoted. Quoting it is precisely wrong
# here: the list is whitespace-separated package names that have to word-split
# into separate arguments, and quoted it becomes one nonexistent package name.
# hadolint ignore=DL3008,SC2046
RUN apt-get update && \
    bash /tmp/calibre-deps.sh && \
    apt-get install -y --no-install-recommends $(cat /mod-repo-packages-to-install.list 2>/dev/null || true) && \
    rm -rf /var/lib/apt/lists/* /tmp/calibre-deps.sh /mod-repo-packages-to-install.list && \
    mkdir -p /app/calibre && \
    tar xf /calibre.txz -C /app/calibre && \
    /app/calibre/calibre_postinstall && \
    rm /calibre.txz
