{
  "title": "Podman Containers",
  "uid": "podman-containers",
  "schemaVersion": 38,
  "version": 29,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "pod",
        "label": "Pod",
        "description": "This stack's pod, found from its gluetun container. podman-compose names it pod_<project>, and the project name varies (COMPOSE_PROJECT_NAME, or the checkout's directory name).",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(podman_container_info{name=~\".*gluetun\"}, pod_name)",
        "multi": false,
        "includeAll": false,
        "refresh": 2
      },
      {
        "name": "stack",
        "label": "Stack",
        "description": "Filter by app stack. Each value is the set of repo container names in that stack.",
        "type": "custom",
        "query": "Downloaders : jdownloader2|qbittorrent|sabnzbd, Indexers : nzbhydra2|prowlarr, Media & Library : jellyfin|audiobookshelf|calibre|calibre-web|korsync, Observability : cadvisor|podman_exporter|podman_limits_exporter|node_exporter|nginx_exporter|qbittorrent_exporter|sabnzbd_exporter|alloy|prometheus|loki|grafana|log_rotator, VPN : gluetun, Proxy : nginx, Homepage : homepage, Servarr : bazarr|cleanuparr|flaresolverr|lidarr|radarr|readarr|recyclarr|sonarr|whisparr|mylar|lazylibrarian",
        "multi": true,
        "includeAll": true,
        "allValue": "jdownloader2|qbittorrent|sabnzbd|nzbhydra2|prowlarr|jellyfin|audiobookshelf|calibre|calibre-web|korsync|cadvisor|podman_exporter|podman_limits_exporter|node_exporter|nginx_exporter|qbittorrent_exporter|sabnzbd_exporter|alloy|prometheus|loki|grafana|log_rotator|gluetun|nginx|homepage|bazarr|cleanuparr|flaresolverr|lidarr|radarr|readarr|recyclarr|sonarr|whisparr|mylar|lazylibrarian"
      },
      {
        "name": "container",
        "label": "Container",
        "description": "Filter the time-series panels by container. Narrows to the containers in the selected stack.",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(podman_container_info{pod_name=\"$pod\",name=~\".*(${stack:raw})\"}, name)",
        "multi": true,
        "includeAll": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "CPU",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "CPU Usage (cores)",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(podman_container_cpu_seconds_total{pod_name=\"$pod\",name=~\"$container\"}[$__rate_interval])",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "CPU Usage (% of System)",
      "description": "CPU usage as a percentage of total logical CPU capacity. Denominator is read live from node_exporter so it stays accurate if the host changes.",
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "rate(podman_container_cpu_seconds_total{pod_name=\"$pod\",name=~\"$container\"}[$__rate_interval]) / scalar(count(count(node_cpu_seconds_total) by (cpu))) * 100",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 21,
      "type": "bargauge",
      "title": "Peak CPU per Container (cores)",
      "description": "Maximum CPU core usage per container over the selected time window. Use these values to set the cpus: limit in Docker Compose. Sorted highest first.",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "decimals": 3,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sort_desc(max_over_time(rate(podman_container_cpu_seconds_total{pod_name=\"$pod\",name=~\"$container\"}[$__rate_interval])[$__range:30s]))",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ]
    },
    {
      "id": 22,
      "type": "bargauge",
      "title": "CPU Limit per Container (vCPUs)",
      "description": "Configured cpus: limit per container from Docker Compose. Containers with no limit set show 0. Compare against Peak CPU to tune limits.",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "decimals": 3,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sort_desc(podman_container_cpu_limit_vcpus{name=~\"$container\"} > 0)",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ]
    },
    {
      "id": 101,
      "type": "row",
      "title": "Memory",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Memory Usage",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "podman_container_mem_usage_bytes{pod_name=\"$pod\",name=~\"$container\"}",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory Limit",
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "lineStyle": {
              "fill": "dash"
            }
          }
        }
      },
      "targets": [
        {
          "expr": "podman_container_mem_limit_bytes{pod_name=\"$pod\",name=~\"$container\"}",
          "legendFormat": "{{name}} limit",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 102,
      "type": "row",
      "title": "Block I/O",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Block I/O Read",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(podman_container_block_input_total{pod_name=\"$pod\",name=~\"$container\"}[5m])",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Block I/O Write",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(podman_container_block_output_total{pod_name=\"$pod\",name=~\"$container\"}[5m])",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 103,
      "type": "row",
      "title": "Network I/O",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Network Input",
      "description": "qbittorrent, sabnzbd, and jdownloader2 share gluetun's network namespace. Their traffic is shown using app-level metrics (qbittorrent exporter, sabnzbd exporter). jdownloader2 is excluded as no application metrics are available.",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(podman_container_net_input_total{pod_name=\"$pod\",name=~\"$container\", name!~\".*(qbittorrent|sabnzbd|jdownloader2)\"}[5m])",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(qbittorrent_dl_info_data_total{job=\"qbittorrent\"}[5m])",
          "legendFormat": "qbittorrent",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sabnzbd_queue_download_rate_bytes_per_second",
          "legendFormat": "sabnzbd",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Network Output",
      "description": "qbittorrent, sabnzbd, and jdownloader2 share gluetun's network namespace. qbittorrent upload rate is shown using app-level metrics (qbittorrent exporter). sabnzbd and jdownloader2 are excluded as no outbound metrics are available.",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "binBps",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "rate(podman_container_net_output_total{pod_name=\"$pod\",name=~\"$container\", name!~\".*(qbittorrent|sabnzbd|jdownloader2)\"}[5m])",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(qbittorrent_up_info_data_total{job=\"qbittorrent\"}[5m])",
          "legendFormat": "qbittorrent",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 104,
      "type": "row",
      "title": "Processes",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Process Count",
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        }
      },
      "targets": [
        {
          "expr": "podman_container_pids{pod_name=\"$pod\",name=~\"$container\"}",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Processes Status",
      "description": "Processes currently in runnable or blocked states on the host. Helps identify CPU contention or I/O wait bottlenecks.",
      "gridPos": {
        "x": 12,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 20,
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "showPoints": "never",
            "spanNulls": false
          }
        }
      },
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "node_procs_blocked{job=\"node_exporter\"}",
          "legendFormat": "Blocked (I/O Wait)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "node_procs_running{job=\"node_exporter\"}",
          "legendFormat": "Runnable (Ready for CPU)",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 24,
      "type": "bargauge",
      "title": "Peak Process per Container",
      "description": "Maximum PID count per container over the selected time window. Use these values to set the pids_limit: in Docker Compose. Sorted highest first.",
      "gridPos": {
        "x": 0,
        "y": 57,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sort_desc(max_over_time(podman_container_pids{pod_name=\"$pod\",name=~\"$container\"}[$__range]))",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ]
    },
    {
      "id": 25,
      "type": "bargauge",
      "title": "Process Limit per Container",
      "description": "Configured pids_limit: per container from Docker Compose. Containers with no limit set show 0. Compare against Peak Process to tune limits.",
      "gridPos": {
        "x": 12,
        "y": 57,
        "w": 12,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sort_desc(podman_container_pids_limit{name=~\"$container\"} > 0)",
          "legendFormat": "{{name}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "instant": true
        }
      ]
    }
  ],
  "tags": [
    "containers",
