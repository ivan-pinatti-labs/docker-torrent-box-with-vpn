  location /jdownloader2/ {
    rewrite                     ^/jdownloader2/(.*) /$1 break;
    proxy_pass                  $jdownloader2_upstream;
    # jDownloader2's web auth builds redirects (e.g. to /login/) as a bare
    # root-relative path, with no scheme or host at all, so the
    # $scheme://$host/ form below never matches it; confirmed live via
    # curl -D, the actual Location header is just "/login/". Without the
    # relative-path rule too, that Location passes through unmodified,
    # escapes the /jdownloader2/ prefix, and 404s against the next
    # location's catch-all instead of landing back inside this proxy.
    proxy_redirect              / /jdownloader2/;
    proxy_redirect              $scheme://$host/ $scheme://$host/jdownloader2/;
    proxy_http_version          1.1;
    proxy_pass_request_headers  on;
    proxy_set_header            Upgrade $http_upgrade;
    proxy_set_header            Connection $http_connection;
    proxy_set_header            Host $host;
    proxy_set_header            X-Real-IP $remote_addr;
    proxy_set_header            X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header            X-Forwarded-Proto $scheme;
    proxy_set_header            X-Forwarded-Protocol $scheme;
    proxy_set_header            X-Forwarded-Host $http_host;
    access_log                  /var/log/nginx/services/jdownloader2-access.log  stripsecrets;
    error_log                   /var/log/nginx/services/jdownloader2-error.log  warn;
  }

  location /qbittorrent/ {
    # proxy_pass                http://gluetun:${QBITTORRENT_HTTP_PORT}/;
    rewrite                     ^/qbittorrent/(.*) /$1 break;
    proxy_pass                  $qbittorrent_upstream;
    proxy_ssl_verify            off;
    proxy_redirect              off;
    proxy_http_version          1.1;
    proxy_pass_request_headers  on;
    proxy_set_header            Upgrade $http_upgrade;
    proxy_set_header            Connection $http_connection;
    proxy_set_header            Host $host;
    proxy_set_header            X-Real-IP $remote_addr;
    # Overwritten, never appended to. qBittorrent trusts nginx as its reverse
    # proxy and takes the client from this header, and it lets
    # READARR_SERVICES_IP in without a login. Appending would keep whatever
    # the browser sent, so a browser claiming Readarr's address would skip
    # that login (#411).
    proxy_set_header            X-Forwarded-For $remote_addr;
    proxy_set_header            X-Forwarded-Proto $scheme;
    proxy_set_header            X-Forwarded-Protocol $scheme;
    proxy_set_header            X-Forwarded-Host $http_host;
    access_log                  /var/log/nginx/services/qbittorrent-access.log  stripsecrets;
    error_log                   /var/log/nginx/services/qbittorrent-error.log  warn;
  }

