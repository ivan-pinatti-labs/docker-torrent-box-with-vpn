    proxy_set_header            X-Forwarded-Proto $scheme;
    proxy_set_header            X-Forwarded-Protocol $scheme;
    proxy_set_header            X-Forwarded-Host $http_host;
    access_log                  /var/log/nginx/services/flaresolverr-access.log  stripsecrets;
    error_log                   /var/log/nginx/services/flaresolverr-error.log  warn;
  }

