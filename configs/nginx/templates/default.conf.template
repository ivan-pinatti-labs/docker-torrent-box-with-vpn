# This is required to proxy Grafana Live WebSocket connections.
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Suppress internal Grafana API calls (ds/query, live, etc.) from access logs.
# Page-level navigation still gets logged; background polling does not.
map $request_uri $grafana_log_enabled {
    ~^/admin/grafana/api/  0;
    default                1;
}

# Optional host name per app (#413): <app>.${APP_PROXY_DOMAIN} opens the app
# at its path on this server, so a password manager can tell the apps apart
# by host name. The default domain, invalid, never resolves, so nothing
# matches. A name is its location's, with `_` turned into `-` (a host name
# cannot hold `_`), and the /admin/ apps go by their bare name. Jellyfin has
# JELLYFIN_PROXY_DOMAIN instead, KOReader Sync a server block of its own at
# the end of this file, and the other paths that are not a UI have none.
map $host $app_proxy_path {
  default                             "";
  audiobookshelf.${APP_PROXY_DOMAIN}  /audiobookshelf/;
  bazarr.${APP_PROXY_DOMAIN}          /bazarr/;
  cadvisor.${APP_PROXY_DOMAIN}        /admin/cadvisor/;
  calibre.${APP_PROXY_DOMAIN}         /calibre/;
  calibre-web.${APP_PROXY_DOMAIN}     /calibre_web/;
  cleanuparr.${APP_PROXY_DOMAIN}      /cleanuparr/;
  grafana.${APP_PROXY_DOMAIN}         /admin/grafana/;
  jdownloader2.${APP_PROXY_DOMAIN}    /jdownloader2/;
  lazylibrarian.${APP_PROXY_DOMAIN}   /lazylibrarian/;
  lidarr.${APP_PROXY_DOMAIN}          /lidarr/;
  mylar.${APP_PROXY_DOMAIN}           /mylar/;
  nzbhydra2.${APP_PROXY_DOMAIN}       /nzbhydra2/;
  prometheus.${APP_PROXY_DOMAIN}      /admin/prometheus/;
  prowlarr.${APP_PROXY_DOMAIN}        /prowlarr/;
  qbittorrent.${APP_PROXY_DOMAIN}     /qbittorrent/;
  radarr.${APP_PROXY_DOMAIN}          /radarr/;
  readarr.${APP_PROXY_DOMAIN}         /readarr/;
  sabnzbd.${APP_PROXY_DOMAIN}         /sabnzbd/;
  sonarr.${APP_PROXY_DOMAIN}          /sonarr/;
  whisparr.${APP_PROXY_DOMAIN}        /whisparr/;
}

# Where an app's host name sends a request for `/`; empty for any other path,
# so the app's own paths under that host are served as usual.
map "$app_proxy_path:$uri" $app_proxy_redirect {
  default                             "";
  "~^(?<app_proxy_target>/[^:]+):/$"  $app_proxy_target;
}

# The app each proxied path belongs to, and the profile that switches it on,
# for the error pages below (#415). Keyed on $request_uri, which an
# error_page redirect leaves as the browser asked for it. A path matching no
# key is proxied to Homepage (`location /`), hence the default, and
# /stub_status belongs to nginx itself. Every `location` of the HTTPS server
# has a key here (tests/test_compose_config.py), and
# scripts/generate-nginx-disabled-apps.py reads $app_profile to list the
# paths whose app is switched off.
map $request_uri $app_name {
  default                            Homepage;
  ~^/stub_status(?:\?|$)             "";
  ~^/admin/cadvisor(?:[/?]|$)        cAdvisor;
  ~^/admin/grafana(?:[/?]|$)         Grafana;
  ~^/admin/node_exporter(?:[/?]|$)   "Node Exporter";
  ~^/admin/prometheus(?:[/?]|$)      Prometheus;
  ~^/audiobookshelf(?:[/?]|$)        Audiobookshelf;
  ~^/bazarr(?:[/?]|$)                Bazarr;
  ~^/calibre(?:[/?]|$)               Calibre;
  ~^/calibre_content(?:[/?]|$)       "Calibre content server";
  ~^/calibre_web(?:[/?]|$)           Calibre-Web;
  ~^/cleanuparr(?:[/?]|$)            Cleanuparr;
  ~^/flaresolverr(?:[/?]|$)          FlareSolverr;
  ~^/gluetun(?:[/?]|$)               Gluetun;
  ~^/jdownloader2(?:[/?]|$)          JDownloader2;
  ~^/jellyfin(?:[/?]|$)              Jellyfin;
  ~^/korsync(?:[/?]|$)               "KOReader Sync";
  ~^/lazylibrarian(?:[/?]|$)         LazyLibrarian;
  ~^/lidarr(?:[/?]|$)                Lidarr;
  ~^/mylar(?:[/?]|$)                 Mylar;
  ~^/nzbhydra2(?:[/?]|$)             NZBHydra2;
  ~^/prowlarr(?:[/?]|$)              Prowlarr;
  ~^/qbittorrent(?:[/?]|$)           qBittorrent;
  ~^/radarr(?:[/?]|$)                Radarr;
  ~^/readarr(?:[/?]|$)               Readarr;
  ~^/sabnzbd(?:[/?]|$)               SABnzbd;
  ~^/sonarr(?:[/?]|$)                Sonarr;
  ~^/whisparr(?:[/?]|$)              Whisparr;
}

map $request_uri $app_profile {
  default                            HOMEPAGE_PROFILE;
  ~^/stub_status(?:\?|$)             "";
  ~^/admin/cadvisor(?:[/?]|$)        CADVISOR_PROFILE;
  ~^/admin/grafana(?:[/?]|$)         GRAFANA_PROFILE;
  ~^/admin/node_exporter(?:[/?]|$)   NODE_EXPORTER_PROFILE;
  ~^/admin/prometheus(?:[/?]|$)      PROMETHEUS_PROFILE;
  ~^/audiobookshelf(?:[/?]|$)        AUDIOBOOKSHELF_PROFILE;
  ~^/bazarr(?:[/?]|$)                BAZARR_PROFILE;
  ~^/calibre(?:[/?]|$)               CALIBRE_PROFILE;
  ~^/calibre_content(?:[/?]|$)       CALIBRE_PROFILE;
  ~^/calibre_web(?:[/?]|$)           CALIBREWEB_PROFILE;
  ~^/cleanuparr(?:[/?]|$)            CLEANUPARR_PROFILE;
  ~^/flaresolverr(?:[/?]|$)          FLARESOLVERR_PROFILE;
  ~^/gluetun(?:[/?]|$)               GLUETUN_PROFILE;
  ~^/jdownloader2(?:[/?]|$)          JDOWNLOADER2_PROFILE;
  ~^/jellyfin(?:[/?]|$)              JELLYFIN_PROFILE;
  ~^/korsync(?:[/?]|$)               KORSYNC_PROFILE;
  ~^/lazylibrarian(?:[/?]|$)         LAZYLIBRARIAN_PROFILE;
  ~^/lidarr(?:[/?]|$)                LIDARR_PROFILE;
  ~^/mylar(?:[/?]|$)                 MYLAR_PROFILE;
  ~^/nzbhydra2(?:[/?]|$)             NZBHYDRA2_PROFILE;
  ~^/prowlarr(?:[/?]|$)              PROWLARR_PROFILE;
  ~^/qbittorrent(?:[/?]|$)           QBITTORRENT_PROFILE;
  ~^/radarr(?:[/?]|$)                RADARR_PROFILE;
  ~^/readarr(?:[/?]|$)               READARR_PROFILE;
  ~^/sabnzbd(?:[/?]|$)               SABNZBD_PROFILE;
  ~^/sonarr(?:[/?]|$)                SONARR_PROFILE;
  ~^/whisparr(?:[/?]|$)              WHISPARR_PROFILE;
}

# 1 for a path whose app's profile is off. `make start` writes the entries
# from .env (scripts/generate-nginx-disabled-apps.py) and reloads a running
# nginx. A glob, so nginx still starts before the file exists, every app
# then counting as enabled.
map $request_uri $app_disabled {
  include /etc/nginx/generated/*.conf;
}

# Refuse a disabled app's path, but not the error page the refusal is
# redirected to: $request_uri, and so $app_disabled, stays the same across
# that redirect. Volatile, so it is worked out again after the redirect.
map "$app_disabled:$uri" $app_refused {
  volatile;
  default            0;
  "~^1:(?!/_errors/)" 1;
}

proxy_cache_path /var/cache/nginx/proxy levels=1:2 keys_zone=proxy_cache:10m max_size=${NGINX_PROXY_CACHE_MAX_SIZE} inactive=${NGINX_PROXY_CACHE_INACTIVE} use_temp_path=off;

server {
  listen ${NGINX_HTTP_PORT};
  server_name _;

  location = /stub_status {
    stub_status;
    access_log off;
    allow 127.0.0.1;
    allow ${OBSERVABILITY_SUBNET};
    deny all;
  }

  location / {
    return 301 https://$host:${NGINX_HTTPS_PORT}$request_uri;
  }
}

server {
  listen ${NGINX_HTTPS_PORT} ssl;

  ssl_certificate       /certs/server.crt;
  ssl_certificate_key   /certs/server.key;
  ssl_protocols         TLSv1.2 TLSv1.3;
  ssl_ciphers           HIGH:!aNULL:!MD5;

  # A cold library listing has to stat every item, and on external storage
  # that first call can outrun nginx's 60s default and return 504 while the
  # app itself is fine. Confirmed live: Lidarr's /api/v1/artist took over a
  # minute cold and 2s once cached. Set here so every location inherits it.
  proxy_read_timeout     180s;
  proxy_cache            proxy_cache;
  proxy_cache_methods    GET HEAD;
  proxy_cache_revalidate on;
  proxy_cache_min_uses   2;
  proxy_cache_use_stale  error timeout updating http_500 http_502 http_503 http_504;
  proxy_cache_lock       on;
  proxy_no_cache         $http_authorization $http_pragma;
  proxy_cache_bypass     $http_authorization $http_pragma;
  add_header             X-Cache-Status $upstream_cache_status always;

  # An app that is switched off, or that nginx cannot reach, gets a page
  # naming it instead of nginx's bare error (#415). A disabled app's path
  # answers 503 before it is proxied. 502 and 504 are nginx's own failures to
  # reach an app; an app's own error statuses still pass through unchanged,
  # since proxy_intercept_errors stays off. The pages are addressed by URI,
  # not as named locations, because only a URI redirect turns a POST (a login
  # form) into the GET a static page can answer; a named one gave 405.
  #
  # An app's host name redirects to its path first, at server level rather
  # than in Homepage's `location /`, so a disabled Homepage does not answer
  # for it. 302, so a browser forgets it once the setting changes, and
  # $http_host keeps a port other than 443.
  if ($app_proxy_redirect) {
    return 302 $scheme://$http_host$app_proxy_redirect;
  }
  if ($app_refused) {
    return 503;
  }
  error_page 503     /_errors/disabled.html;
  error_page 502 504 /_errors/unavailable.html;

  location ^~ /_errors/ {
    internal;
    alias   /etc/nginx/errors/;
    ssi     on;
  }

  location = /stub_status {
    stub_status;
    access_log off;
    allow 127.0.0.1;
    allow ${OBSERVABILITY_SUBNET};
    deny all;
  }

  set $homepage_upstream      http://homepage:${HOMEPAGE_HTTP_PORT};
  set $bazarr_upstream        ${BAZARR_UPSTREAM_SCHEME}://${BAZARR_UPSTREAM_HOST}:${BAZARR_UPSTREAM_PORT};
  set $cadvisor_upstream      http://cadvisor:${CADVISOR_HTTP_PORT};
  set $cleanuparr_upstream    http://cleanuparr-http:${CLEANUPARR_UPSTREAM_PORT};
  set $flaresolverr_upstream  ${FLARESOLVERR_UPSTREAM_SCHEME}://${FLARESOLVERR_UPSTREAM_HOST}:${FLARESOLVERR_UPSTREAM_PORT};
  set $grafana_upstream       http://grafana:3000;
  set $gluetun_upstream       http://gluetun:8000;
  set $jellyfin_upstream      http://jellyfin:${JELLYFIN_UPSTREAM_PORT};
  set $lidarr_upstream        ${LIDARR_UPSTREAM_SCHEME}://${LIDARR_UPSTREAM_HOST}:${LIDARR_UPSTREAM_PORT};
  set $node_exporter_upstream http://node_exporter:${NODE_EXPORTER_HTTP_PORT};
  set $prometheus_upstream    http://prometheus:9090;
  set $prowlarr_upstream      ${PROWLARR_UPSTREAM_SCHEME}://${PROWLARR_UPSTREAM_HOST}:${PROWLARR_UPSTREAM_PORT};
  set $qbittorrent_upstream   https://${GLUETUN_SERVICES_IP}:${QBITTORRENT_HTTPS_PORT};
  set $radarr_upstream        ${RADARR_UPSTREAM_SCHEME}://${RADARR_UPSTREAM_HOST}:${RADARR_UPSTREAM_PORT};
  set $readarr_upstream       ${READARR_UPSTREAM_SCHEME}://${READARR_UPSTREAM_HOST}:${READARR_UPSTREAM_PORT};
  set $nzbhydra2_upstream     ${NZBHYDRA2_UPSTREAM_SCHEME}://${NZBHYDRA2_UPSTREAM_HOST}:${NZBHYDRA2_UPSTREAM_PORT};
  set $sabnzbd_upstream       ${SABNZBD_UPSTREAM_SCHEME}://${SABNZBD_UPSTREAM_HOST}:${SABNZBD_UPSTREAM_PORT};
  set $sonarr_upstream        ${SONARR_UPSTREAM_SCHEME}://${SONARR_UPSTREAM_HOST}:${SONARR_UPSTREAM_PORT};
  set $whisparr_upstream        ${WHISPARR_UPSTREAM_SCHEME}://${WHISPARR_UPSTREAM_HOST}:${WHISPARR_UPSTREAM_PORT};
  set $audiobookshelf_upstream  ${AUDIOBOOKSHELF_UPSTREAM_SCHEME}://${AUDIOBOOKSHELF_UPSTREAM_HOST}:${AUDIOBOOKSHELF_UPSTREAM_PORT};
  set $korsync_upstream          ${KORSYNC_UPSTREAM_SCHEME}://${KORSYNC_UPSTREAM_HOST}:${KORSYNC_UPSTREAM_PORT};
  set $calibre_upstream         ${CALIBRE_UPSTREAM_SCHEME}://${CALIBRE_UPSTREAM_HOST}:${CALIBRE_UPSTREAM_PORT};
  set $calibreweb_upstream      ${CALIBREWEB_UPSTREAM_SCHEME}://${CALIBREWEB_UPSTREAM_HOST}:${CALIBREWEB_UPSTREAM_PORT};
  set $calibre_content_upstream ${CALIBRE_CONTENT_UPSTREAM_SCHEME}://${CALIBRE_CONTENT_UPSTREAM_HOST}:${CALIBRE_CONTENT_UPSTREAM_PORT};
  set $lazylibrarian_upstream   ${LAZYLIBRARIAN_UPSTREAM_SCHEME}://${LAZYLIBRARIAN_UPSTREAM_HOST}:${LAZYLIBRARIAN_UPSTREAM_PORT};
  set $mylar_upstream           ${MYLAR_UPSTREAM_SCHEME}://${MYLAR_UPSTREAM_HOST}:${MYLAR_UPSTREAM_PORT};
  # jDownloader2 runs with SECURE_CONNECTION=1 (self-signed certificate), so
  # the upstream is https even though the port variable is named HTTP.
  set $jdownloader2_upstream    https://${GLUETUN_SERVICES_IP}:${JDOWNLOADER2_HTTP_PORT};

## Homepage
  location / {
    proxy_pass                  $homepage_upstream;
    proxy_redirect              off;
    proxy_http_version          1.1;
