    access_log                  /var/log/nginx/services/bazarr-access.log  stripsecrets;
    error_log                   /var/log/nginx/services/bazarr-error.log  warn;
  }

  # Cleanuparr serves everything under BASE_PATH, so no rewrite. It trusts no
  # forwarded header (TrustForwardedHeaders stays off), and X-Forwarded-For
  # is overwritten anyway, as for qBittorrent and SABnzbd, so nothing a
  # browser sends can name another client.
  #
  # Its first-run setup endpoints answer anyone until an account exists, and
  # the container starts before `make wire_connections` makes that account,
  # so through here anyone who reached nginx first could create the admin
  # account and lock the stack's wiring out. The wiring never comes this way:
  # it calls Cleanuparr from inside its own container. So nginx refuses them,
  # in any case: Cleanuparr's routes match case-insensitively, and a regex
  # location is checked ahead of the plain /cleanuparr/ prefix.
  location ~* ^/cleanuparr/api/auth/setup(?:/|$) {
    return 403;
  }

  location /cleanuparr/ {
    proxy_pass                  $cleanuparr_upstream;
    proxy_redirect              off;
    proxy_http_version          1.1;
    proxy_pass_request_headers  on;
    proxy_set_header            Upgrade $http_upgrade;
    proxy_set_header            Connection $http_connection;
    proxy_set_header            Host $host;
