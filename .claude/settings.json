{
  "permissions": {
    "allow": [
      "Bash(podman logs *)",
      "Bash(podman ps *)",
      "Bash(podman inspect *)",
      "Bash(podman images *)",
      "Bash(podman top *)",
      "Bash(podman stats *)",
      "Bash(podman version *)",
      "Bash(podman info *)",
      "Bash(docker ps *)",
      "Bash(docker logs *)",
      "Bash(docker inspect *)",
      "Bash(docker images *)",
      "Bash(docker top *)",
      "Bash(docker stats *)",
      "Bash(docker version *)",
      "Bash(docker info *)",
      "Bash(ls *)",
      "Bash(ps *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(uname *)",
      "Bash(whoami)",
      "Bash(id *)",
      "Bash(uptime)",
      "Bash(asdf list *)",
      "Bash(asdf current *)",
      "Bash(asdf where *)",
      "Bash(asdf which *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/git-guard.sh\"",
            "statusMessage": "Checking this git command is safe to run here"
          }
        ]
      }
    ]
  }
}
